{
  "manifest_version": 3,
  "name": "SuperMemo Clipper v2",
  "version": "2.0.1",
  "description": "一键清理网页广告与无关格式，只保留标题、网址和正文；自动在 SuperMemo 新建条目（Alt+N）并粘贴（Ctrl+V）。",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "提取正文并粘贴到 SuperMemo（自动 Alt+N）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
