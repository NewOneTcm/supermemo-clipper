{
  "manifest_version": 3,
  "name": "SuperMemo Clipper v2",
  "version": "2.3.0",
  "description": "一键清理网页广告与无关格式，保留标题、网址和正文（正文/全页双模式）；自动在 SuperMemo 新建条目并粘贴（Ctrl+N），并把剪贴板来源地址改成网页地址以避免 res:// 对话框。",
  "permissions": ["activeTab", "scripting", "nativeMessaging", "storage"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "提取正文并粘贴到 SuperMemo（自动 Ctrl+N）",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
